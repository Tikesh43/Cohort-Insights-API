# Application Configuration
APP_NAME="Cohort Insights API"
ENVIRONMENT="production"
DEBUG=false

# MongoDB Configuration
MONGODB_URL="mongodb://mongo:27017"
DATABASE_NAME="cohort_insights"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_CACHE_TTL_SECONDS=86400
REDIS_RATELIMIT_TTL_SECONDS=3600

# Rate Limiter
MAX_ACTIVE_DOCUMENTS=3

# Worker Pipeline Simulation Configuration
SIMULATION_PROCESSING_DELAY_MIN=10.0
SIMULATION_PROCESSING_DELAY_MAX=20.0
SIMULATION_ENRICHING_DELAY_MIN=5.0
SIMULATION_ENRICHING_DELAY_MAX=15.0
STAGE_FAILURE_RATE=0.10
LEASE_TIMEOUT_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=1.0
ENABLE_IN_PROCESS_WORKER=true
